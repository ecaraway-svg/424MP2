import java.util.Random;
import java.util.Arrays;


public class MatrixMultiplication {

    static class ThreadWorker extends Thread {
        private final int startR;
        private final int endR;
        private final int[][] matrix_A;
        private final int[][] matrix_B;
        private final int[][] matrix_C;

        public ThreadWorker(int startR, int endR, int[][] matrix_A, int[][] matrix_B, int[][] matrix_C) {
            this.startR = startR;
            this.endR = endR;
            this.matrix_A = matrix_A;
            this.matrix_B = matrix_B;
            this.matrix_C = matrix_C;
        }

        @Override 
        public void run() {
            for (int i = startR; i < endR; i++) {
                for (int j = 0; j < 20; j++) {
                    matrix_C[i][j] = 0;
                    for (int k = 0; k < 20; k++) {
                        matrix_C[i][j] += matrix_A[i][k] * matrix_B[k][j];
                    }
                }
            }
        }
    }
   
   
    public static void main(String[] args){ //main
         System.out.println("MP 2, Matrix Multiplication Program");


        int[][] matrix_A = new int[20][20];
        int[][] matrix_B = new int[20][20];
        //create two 20x20 matrix

        int[][] matrix_C = new int[20][20];


        int rows = 20;
        int columns = 20;


        Random rand = new Random();


        for(int i = 0; i < rows; i++){
            for(int j = 0; j < columns; j++){
                //use nested for loop to assign random integers to matrix A & B
                matrix_A[i][j] = rand.nextInt(100);
                matrix_B[i][j] = rand.nextInt(100);
            }
        }

        int threadnum = 5;
        int rowsperthread = rows / threadnum;

        ThreadWorker[] threads = new ThreadWorker[threadnum];

        for (int i = 0; i < threadnum; i++) {
            int startR = i * rowsperthread;
            int endR = startR + rowsperthread;
            threads[i] = new ThreadWorker(startR, endR, matrix_A, matrix_B, matrix_C);
            threads[i].start();
        }
            
        
        for (int i = 0; i < threadnum; i++) {
            try {
                threads[i].join();
        }   catch (InterruptedException e) {
                e.printStackTrace();
        }
        }

        System.out.println("Result Matrix:");


        for (int i = 0; i < 20; i++) {
            for (int j = 0; j < 20; j++) {
                System.out.print(matrix_C[i][j] + "\t");
            }
            System.out.println();
        }


    }
}
